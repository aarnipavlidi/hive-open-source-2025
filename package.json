{
  "name": "hive-open-source-2025",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "docker:build:local": "docker build -t hive-open-source-2025:local .",
    "docker:run:local": "docker run --rm --env-file .env.local -p 3001:3001 hive-open-source-2025:local",
    "gen:supabase-variables": "bash ./scripts/generate-supabase-variables.sh",
    "gen:types:stg": "dotenv -e .env.local -- sh -c 'supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" > types/database.ts'",
    "migration:new": "bash ./scripts/generate-supabase-migration.sh",
    "migration:list:stg": "dotenv -e .env.local -- sh -c 'supabase migration list --db-url \"$SUPABASE_DB_URL\"'",
    "migration:repair:stg": "dotenv -e .env.local -- node scripts/repair-supabase-migrations.js",
    "db:push:stg": "dotenv -e .env.local -- sh -c 'supabase db push --db-url \"$SUPABASE_DB_URL\"'",
    "db:reset:stg": "dotenv -e .env.local -- sh -c 'supabase db reset --db-url \"$SUPABASE_DB_URL\"'",
    "supabase:dev:up": "docker compose -f supabase/staging-docker-compose.yaml --env-file .env.local up -d",
    "supabase:dev:down": "docker compose -f supabase/staging-docker-compose.yaml --env-file .env.local down",
    "supabase:dev:logs": "docker compose -f supabase/staging-docker-compose.yaml --env-file .env.local logs -f --tail=100"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.1.3",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "inquirer": "^13.1.0",
    "supabase": "^2.70.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
